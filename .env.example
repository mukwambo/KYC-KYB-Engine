# KYC/KYB Engine environment variables.
# Generated from src/environment/index.ts. Copy to .env and fill in.
# Values here are placeholders only. Never commit real secrets.

# default=development
NODE_ENV=development

# default=3000
PORT=3000

# REQUIRED — Postgres connection string used by Prisma.
DATABASE_URL=postgresql://kyc_kyb:kyc_kyb@localhost:5432/kyc_kyb_engine?schema=public

# REQUIRED — Redis connection string, shared by caching and BullMQ.
# Host port 6380 by default (docker-compose.yml) to avoid clashing with any
# other local Redis on the standard 6379 — adjust if yours is free.
REDIS_URL=redis://localhost:6380

# REQUIRED — signs and verifies JWTs. Use a long random value in every real environment.
JWT_SECRET=

# default=15m
JWT_EXPIRES_IN=15m
